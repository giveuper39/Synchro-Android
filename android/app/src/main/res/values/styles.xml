<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseAppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/amber</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorPrimaryContainer">#423713</item>
        <item name="colorOnPrimaryContainer">#FFE8A2</item>
        <item name="colorSecondary">#BEC7D6</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">#424448</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme"/>
    <style name="ScannerTheme" parent="AppTheme"><item name="android:windowFullscreen">true</item></style>
    <style name="Text.Kicker" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="PlayerIconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_glass_button</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">@color/text_primary</item>
    </style>
    <style name="PlayerChip" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">#99323236</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconSize">18dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>
    <style name="Synchro.QuietButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">#252A32</item><item name="android:textColor">@color/text_primary</item><item name="iconTint">@color/text_primary</item><item name="cornerRadius">18dp</item><item name="android:textSize">14sp</item><item name="android:minHeight">52dp</item>
    </style>
    <style name="Synchro.Title" parent="TextAppearance.Material3.HeadlineMedium"><item name="android:fontFamily">@font/manrope</item><item name="android:textColor">@color/text_primary</item><item name="android:textSize">28sp</item><item name="android:letterSpacing">-0.035</item></style>
    <style name="Synchro.NavLabel" parent="TextAppearance.Material3.LabelSmall"><item name="android:textSize">10sp</item><item name="android:textColor">@color/text_secondary</item><item name="android:gravity">center</item></style>
</resources>
