<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:id="@+id/connection_screen" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical"><ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_brand" android:importantForAccessibility="no"/><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Synchro" android:textSize="23sp" android:textColor="@color/text_primary" android:fontFamily="@font/manrope" android:textStyle="bold" android:letterSpacing="-0.04"/><ImageButton android:id="@+id/home_more" style="@style/PlayerIconButton" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_more" android:contentDescription="О приложении"/></LinearLayout>
    <TextView android:id="@+id/screen_title" style="@style/Synchro.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Ваш просмотр"/>
    <TextView android:id="@+id/screen_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Продолжайте там, где вам удобно." android:textSize="13sp" android:textColor="@color/text_secondary"/>
    <LinearLayout android:id="@+id/saved_computer" android:visibility="gone" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="22dp" android:background="@drawable/bg_card" android:padding="16dp" android:gravity="center_vertical"><ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_computer" app:tint="@color/text_secondary" android:importantForAccessibility="no"/><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical"><TextView android:id="@+id/computer_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ваш компьютер" android:textSize="14sp" android:textColor="@color/text_primary" android:textStyle="bold"/><TextView android:id="@+id/computer_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="11sp" android:textColor="@color/text_secondary"/></LinearLayout><TextView android:id="@+id/connection_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="СОХРАНЁН" android:textSize="9sp" android:letterSpacing="0.06" android:textColor="@color/text_secondary"/></LinearLayout>
    <LinearLayout android:id="@+id/watch_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <LinearLayout android:id="@+id/source_selector" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="18dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:contentDescription="Выбрать источник просмотра"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_sources" app:tint="@color/amber" android:importantForAccessibility="no"/><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ИСТОЧНИК ПРОСМОТРА" android:textSize="9sp" android:letterSpacing="0.11" android:textColor="@color/text_secondary"/><TextView android:id="@+id/source_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Выберите плеер" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold"/></LinearLayout><ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:importantForAccessibility="no"/></LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginTop="8dp" android:background="@drawable/bg_hero" android:clipToOutline="true"><ImageView android:id="@+id/home_poster" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:alpha="0.65" android:src="@drawable/ic_scene" android:importantForAccessibility="no"/><View android:layout_width="match_parent" android:layout_height="200dp" android:layout_gravity="bottom" android:background="@drawable/bg_scrim_bottom"/><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="22dp"><TextView android:id="@+id/media_kind" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ЛОКАЛЬНЫЙ ФАЙЛ" android:textSize="9sp" android:letterSpacing="0.12" android:textColor="#DFE7ED"/><Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/><TextView android:id="@+id/home_media_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Готовы продолжить?" android:textSize="25sp" android:textStyle="bold" android:letterSpacing="-0.035" android:textColor="@color/text_primary" android:maxLines="2" android:ellipsize="end"/><TextView android:id="@+id/home_media_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Откройте видео на компьютере" android:textSize="12sp" android:textColor="#BFCBD7"/><com.google.android.material.button.MaterialButton android:id="@+id/takeover" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:text="Продолжить на телефоне" android:textSize="14sp" app:icon="@drawable/ic_play" app:iconGravity="textStart" app:cornerRadius="16dp"/></LinearLayout></FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Пауза на телефоне вернёт позицию на ПК.
Громкость остаётся на каждом устройстве." android:textSize="11sp" android:lineSpacingExtra="4dp" android:textColor="@color/text_secondary"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/connection_intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:orientation="vertical"><ImageView android:layout_width="match_parent" android:layout_height="156dp" android:src="@drawable/ic_devices" android:importantForAccessibility="no"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Один просмотр.
Любой экран." android:textColor="@color/text_primary" android:textSize="32sp" android:textStyle="bold" android:letterSpacing="-0.04"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Продолжайте видео, передавайте текст и открывайте вкладки между телефоном и ПК." android:textColor="@color/text_secondary" android:textSize="14sp" android:lineSpacingExtra="5dp"/></LinearLayout>
    <LinearLayout android:id="@+id/device_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="22dp"><com.google.android.material.button.MaterialButton android:id="@+id/scan_qr" android:layout_width="match_parent" android:layout_height="56dp" android:text="Подключить по QR" app:icon="@drawable/ic_qr" app:iconGravity="textStart" app:cornerRadius="18dp"/><com.google.android.material.button.MaterialButton android:id="@+id/manual_toggle" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Ввести адрес вручную" android:textColor="@color/text_secondary"/><LinearLayout android:id="@+id/manual_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:orientation="vertical"><com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Адрес компьютера"><com.google.android.material.textfield.TextInputEditText android:id="@+id/server_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:singleLine="true"/></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Ключ подключения" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/token_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:singleLine="true"/></com.google.android.material.textfield.TextInputLayout><com.google.android.material.button.MaterialButton android:id="@+id/connect" style="@style/Synchro.QuietButton" android:layout_width="match_parent" android:layout_height="54dp" android:text="Подключить компьютер"/></LinearLayout><com.google.android.material.button.MaterialButton android:id="@+id/home_updates" style="@style/Synchro.QuietButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="Обновления Synchro" app:icon="@drawable/ic_refresh" app:iconGravity="textStart"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Связь напрямую по локальной сети.
Аккаунт и облачное хранилище не нужны." android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="4dp"/></LinearLayout>
    <TextView android:id="@+id/home_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:textSize="11sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:accessibilityLiveRegion="polite"/>
    </LinearLayout></ScrollView>
    <LinearLayout android:id="@+id/home_features" android:layout_width="match_parent" android:layout_height="72dp" android:background="#191D24" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
<LinearLayout android:id="@+id/nav_watch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:contentDescription="Просмотр"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_watch" app:tint="@color/amber" android:importantForAccessibility="no"/><TextView style="@style/Synchro.NavLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Просмотр"/></LinearLayout><LinearLayout android:id="@+id/hub_clipboard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:contentDescription="Буфер"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_clipboard" app:tint="@color/text_secondary" android:importantForAccessibility="no"/><TextView style="@style/Synchro.NavLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Буфер"/></LinearLayout><LinearLayout android:id="@+id/hub_tabs" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:contentDescription="Вкладки"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_tabs" app:tint="@color/text_secondary" android:importantForAccessibility="no"/><TextView style="@style/Synchro.NavLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Вкладки"/></LinearLayout><LinearLayout android:id="@+id/nav_devices" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:contentDescription="Устройства"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_settings" app:tint="@color/text_secondary" android:importantForAccessibility="no"/><TextView style="@style/Synchro.NavLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Устройства"/></LinearLayout></LinearLayout></LinearLayout>
    <FrameLayout android:id="@+id/player_screen" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
        <org.videolan.libvlc.util.VLCVideoLayout android:id="@+id/video" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <View android:id="@+id/video_touch" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Показать или скрыть элементы управления" android:clickable="true" android:focusable="true"/>
        <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/loading" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:indeterminate="true" android:visibility="gone" android:contentDescription="Загрузка видео" app:indicatorSize="40dp" app:trackThickness="3dp" app:indicatorColor="@color/amber"/>
        <FrameLayout android:id="@+id/player_controls" android:layout_width="match_parent" android:layout_height="match_parent">
            <View android:layout_width="match_parent" android:layout_height="136dp" android:layout_gravity="top" android:background="@drawable/bg_scrim_top"/>
            <View android:layout_width="match_parent" android:layout_height="200dp" android:layout_gravity="bottom" android:background="@drawable/bg_scrim_bottom"/>
            <LinearLayout android:id="@+id/player_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                <ImageButton android:id="@+id/player_back" style="@style/PlayerIconButton" android:src="@drawable/ic_back" android:contentDescription="Вернуть просмотр на ПК и открыть меню"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp" android:layout_marginEnd="12dp">
                    <TextView android:id="@+id/video_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end"/>
                    <TextView android:id="@+id/video_episode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#B3FFFFFF" android:textSize="12sp"/>
                </LinearLayout>
                <ImageButton android:id="@+id/player_queue" style="@style/PlayerIconButton" android:src="@drawable/ic_queue" android:contentDescription="Плейлист"/>
                <ImageButton android:id="@+id/mini_player" style="@style/PlayerIconButton" android:src="@drawable/ic_pip" android:contentDescription="Мини-плеер поверх других приложений"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/transport_controls" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center_vertical">
                <ImageButton android:id="@+id/previous" style="@style/PlayerIconButton" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_previous" android:contentDescription="Предыдущая серия"/>
                <ImageButton android:id="@+id/replay" style="@style/PlayerIconButton" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:src="@drawable/ic_replay" android:contentDescription="Назад на 10 секунд"/>
                <ImageButton android:id="@+id/play_pause" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:padding="22dp" android:background="@drawable/bg_play_button" app:tint="@color/ink" android:src="@drawable/ic_pause" android:contentDescription="Пауза и передача позиции на компьютер"/>
                <ImageButton android:id="@+id/forward" style="@style/PlayerIconButton" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_forward" android:contentDescription="Вперёд на 10 секунд"/>
                <ImageButton android:id="@+id/next" style="@style/PlayerIconButton" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:src="@drawable/ic_next" android:contentDescription="Следующая серия"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/player_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:padding="16dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/retry" style="@style/PlayerChip" android:layout_width="wrap_content" android:layout_height="44dp" android:visibility="gone" android:text="Повторить передачу позиции"/>
                <TextView android:id="@+id/player_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:accessibilityLiveRegion="polite"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="00:00 / 00:00" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/rate" style="@style/PlayerChip" android:layout_width="wrap_content" android:layout_height="36dp" android:text="1×"/>
                    <ImageButton android:id="@+id/fullscreen" style="@style/PlayerIconButton" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:padding="10dp" android:src="@drawable/ic_fullscreen" android:contentDescription="Повернуть видео в альбомный режим"/>
                </LinearLayout>
                <com.google.android.material.slider.Slider android:id="@+id/seek" android:layout_width="match_parent" android:layout_height="36dp" android:valueFrom="0" android:valueTo="10000" android:value="0" app:trackHeight="3dp" app:thumbWidth="12dp" app:thumbHeight="12dp" app:thumbRadius="6dp" app:thumbTrackGapSize="0dp" app:trackStopIndicatorSize="0dp" app:trackColorActive="@color/amber" app:trackColorInactive="#55FFFFFF" app:thumbColor="@color/amber" app:haloRadius="14dp" app:labelBehavior="gone" android:contentDescription="Позиция просмотра"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/audio" style="@style/PlayerChip" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Озвучка" app:icon="@drawable/ic_audio" app:iconGravity="textStart"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/subtitles" style="@style/PlayerChip" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Субтитры" app:icon="@drawable/ic_subtitles" app:iconGravity="textStart"/>
                    <ImageButton android:id="@+id/player_more" style="@style/PlayerIconButton" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:src="@drawable/ic_more" android:contentDescription="Настройки просмотра"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
